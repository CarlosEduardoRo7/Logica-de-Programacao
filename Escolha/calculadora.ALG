Algoritmo "calculadora"

Var

   calculo : caracter
   numero1 : real
   numero2 : real

Inicio

   escreva("Qual calculo você deseja realizar? ")
   leia(calculo)

   escreva("Digite o primeiro numero do calculo: ")
   leia(numero1)

   escreva("Digite o segundo numero do calculo: ")
   leia(numero2)

   escolha(calculo)

   caso "+"
   
   escreval("")

   escreva(numero1 + numero2)
   
   escreval("")
   
   caso "-"

   escreval("")

   escreva(numero1 - numero2)
   
   escreval("")
   
   caso "*"

   escreval("")

   escreva(numero1 * numero2)
   
   escreval("")
   
   caso "/"

   escreval("")

   escreva(numero1 / numero2)
   
   escreval("")

   fimescolha

Fimalgoritmo