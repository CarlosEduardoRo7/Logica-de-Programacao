Algoritmo "Temperatura"


Var

dia : real

Inicio

      escreva("Digite o numero do dia da semana: ")
      leia(dia)
      escreval("")

escolha(dia)

      caso 1
      escreva("Aff é Segunda-Feira")
      escreval("")
      
      caso 2
      escreva("ainda é Terça-Feira")
      escreval("")
      
      caso 3
      escreva("Quarta-Feira, ta melhorando, mas é só a metade")
      escreval("")
      
      caso 4
      escreva("Quinta-feira, melhor aula que tem e amanha ainda é sexta, ta joia")
      escreval("")
      
      caso 5
      escreva("Sexta-Feira, melhor dia da semana, bora descançar")
      escreval("")
      
      caso 6
      escreva("Sábado, muito bom, mas amanha já é Domingo :( ")
      escreval("")
      
      caso 7
      escreva("Domingo, muito bom no inicio, depressivo no final")
      escreval("")
      
      
      outrocaso
      escreva("Dia inválido")
      escreval("")
      
fimescolha

Fimalgoritmo