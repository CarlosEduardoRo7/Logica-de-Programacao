Algoritmo "Temperatura"


Var

temperatura : real

Inicio

      escreva("Digite a Temperatura: ")
      leia(temperatura)
      escreval("")

escolha(temperatura)

      caso -1000 ate -21
      escreva("Virou picolé")
      escreval("")
      
      caso -20 ate 0
      escreva("Está muito frio")
      escreval("")
      
      caso 1 ate 15
      escreva("Está frio")
      escreval("")
      
      caso 15 ate 23
      escreva("Está um clima agradável")
      escreval("")
      
      caso 24 ate 35
      escreva("Está calor")
      escreval("")
      
      caso 36 ate 50
      escreva("Bem vindo a criciúma")
      escreval("")
      
      caso 50 ate 5772
      escreva("Primeiro homem a pisar no sol")
      escreval("")
      
      outrocaso
      escreva("temperatura invalida")
      
fimescolha

Fimalgoritmo