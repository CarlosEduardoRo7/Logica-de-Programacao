Algoritmo "Usuário Maior de Idade"

Var

nome : caracter
idade : inteiro

Inicio

escreva("Digite seu nome: ")
leia(nome)

escreva("Digite sua idade: ")
leia(idade)

se (Idade >= 18) entao

   escreval(" ")
   escreva("Oi ", nome , "! você é maior de idade")
   escreval(" ")
   
   senao
   
      escreval(" ")
      escreva("Oi ", nome , "! você é menor de idade")
      escreval(" ")
      
      fimse
      
Fimalgoritmo