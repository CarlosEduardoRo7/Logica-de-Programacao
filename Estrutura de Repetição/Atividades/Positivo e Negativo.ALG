Algoritmo "Positivo e negativo"

Var

valor : inteiro

Inicio

escreva("Digite o valor: ")
leia(valor)

se (valor >= 0) entao

   escreval(" ")
   escreva("O número", valor ," é positivo!")
   escreval(" ")
   
   senao
   
   escreval(" ")
   escreva("O número", valor ," é negativo!")
   escreval(" ")
   
fimse

Fimalgoritmo