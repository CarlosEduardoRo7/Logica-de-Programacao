Algoritmo "Calculadora"

Var

valor1 : real
valor2 : real
resultado : real
operacao : caracter
   
Inicio

escreva("Digite o primeiro valor: ")
leia(valor1)

escreva("Digite o segundo valor: ")
leia(valor2)

escreva("Digite a operação: ")
leia(operacao)


se (operacao = "adição") entao
   escreval(" ")
   escreva(valor1 + valor2)
   escreval(" ")

   fimse

Fimalgoritmo