Algoritmo "Aluno e Curso"

Var

nome : caracter
curso : caracter

Inicio

escreva("Escreva seu nome: ")
leia(nome)

escreva("Escreva a sigla de seu curso: ")
leia(curso)

se (curso = "ADM") entao
escreval(" ")
escreva("Olá ", nome,", seu curso é Administração!")
escreval(" ")

             senao
             
                  se (curso = "DIR") entao
                  escreval(" ")
                  escreva("Olá ", nome,", seu curso é Direito!")
                  escreval(" ")
                  
                               senao
                               
                               se (curso = "CEX") entao
                               escreval(" ")
                               escreva("Olá ", nome,", seu curso é Comércio Exterior!")
                               escreval(" ")

fimse
fimse
fimse

Fimalgoritmo