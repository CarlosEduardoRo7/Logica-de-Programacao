Algoritmo "exemplo maior ou menor"

Var
      A : inteiro
      B : inteiro
Inicio

     escreva("digite o valor de A: ")
     leia(A)
     escreva("digite o valor de B: ")
     leia(B)

     se ( A = B ) entao
        escreva("O valor de A é igual a B")
        
     senao
          se (A > B) entao
             escreva("O valor de A é maior que o valor de B")
             
          senao
          
          escreva("O valor de A é menor que o valor de B")
          
          fimse

     fimse
     

Fimalgoritmo