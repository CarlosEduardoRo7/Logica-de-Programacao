Algoritmo "exemplo se"

Var
      A : inteiro
      B : inteiro
Inicio

     escreva("digite o valor de A: ")
     leia(A)
     escreva("digite o valor de B: ")
     leia(B)
     
     se ( A = B ) entao
        escreva("A é igual a B")
     senão
         escreva("infelizmente o valor de A é diferente do valor de B")
     fimse

Fimalgoritmo