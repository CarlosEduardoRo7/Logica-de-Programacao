Algoritmo "dados"

Var

nome, endereco, bairro, cidade, estado: caracter
telefone: inteiro

Inicio

escreva("digite seu nome ")
leia(nome)

escreva("digite seu endereço ")
leia(endereco)

escreva("digite seu bairro ")
leia(bairro)

escreva("digite sua cidade ")
leia(cidade)

escreva("digite seu estado ")
leia(estado)

escreva("digite seu telefone ")
leia(telefone)

escreval(" ")
escreval("Cadastro realizado com Sucesso")
escreval("o nome é: ", nome, ", " , telefone)
escreval("o endereço é: ", endereco)
escreval("o bairro é: ", bairro)
escreval("sua cidade é: ", cidade, ", " ,estado)

Fimalgoritmo