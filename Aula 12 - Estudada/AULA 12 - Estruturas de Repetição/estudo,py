print("Operação de divisão")
print("")

while True:
    n1 = float(input("Digite um numero: "))
    n2 = float(input("Digite um numero: "))

    if n1 != 0:
        if n2 != 0:
            print(f"{n1} / {n2} = {(n1/n2):.2f}")
        else:
            print("Divisão Impossivel")
            break
    else:
        print("Divisão Impossivel")
        break